@model Ql_Phongtro.Models.PhongTro

@{
    ViewBag.Title = Model.TieuDe;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var danhSachAnh = Model.HinhAnhPhong != null ? Model.HinhAnhPhong.ToList() : new List<Ql_Phongtro.Models.HinhAnhPhong>();
    var anhBia = danhSachAnh.FirstOrDefault() != null ? danhSachAnh.FirstOrDefault().UrlHinhAnh : "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?w=800";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="container" style="max-width: 1140px; margin: 30px auto 50px auto; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

    <!-- Thông báo sau khi đặt lịch -->
    @if (TempData["LichHenSuccess"] != null)
    {
        <div style="background-color: #e0f2fe; border: 1px solid #bae6fd; color: #0369a1; padding: 14px 20px; border-radius: 12px; margin-bottom: 25px; font-weight: 600; display: flex; align-items: center; gap: 10px;">
            <i class="fa-solid fa-circle-check" style="font-size: 18px; color: #0284c7;"></i>
            <span>@TempData["LichHenSuccess"]</span>
        </div>
    }

    <!-- Tiêu đề & Tag loại hình -->
    <div style="background: #ffffff; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
        <div style="display: flex; gap: 8px; margin-bottom: 12px;">
            <span style="background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px;">@Model.LoaiHinh</span>
            <span style="background: #fef3c7; color: #92400e; font-size: 12px; font-weight: 700; padding: 4px 12px; border-radius: 20px;">@Model.TrangThaiPhong</span>
        </div>
        <h1 style="color: #1e293b; font-size: 26px; font-weight: 800; margin: 0 0 10px 0;">@Model.TieuDe</h1>
        <p style="color: #64748b; font-size: 14px; margin: 0; display: flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-location-dot" style="color: #ef4444;"></i>
            @(Model.DiaChiChiTiet != null ? Model.DiaChiChiTiet + ", " : "") @(Model.TuyenDuong != null ? Model.TuyenDuong.TenDuong : ""), @(Model.PhuongXa != null ? Model.PhuongXa.TenPhuongXa : ""), TP. Cà Mau
        </p>
    </div>

    <style>
        .chotot-gallery {
            background: #111;
            border-radius: 10px;
            overflow: hidden;
            padding: 20px 0 10px 0;
            margin-bottom: 25px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        .main-view {
            position: relative;
            height: 450px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #000;
            margin: 0 20px;
            border-radius: 8px;
            overflow: hidden;
        }

        .nav-btn {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255,255,255,0.8);
            border: none;
            border-radius: 50%;
            width: 45px;
            height: 45px;
            font-size: 20px;
            cursor: pointer;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.3s;
        }

            .nav-btn:hover {
                background: #fff;
                transform: translateY(-50%) scale(1.1);
            }

        .prev-btn {
            left: 15px;
        }

        .next-btn {
            right: 15px;
        }

        .media-counter {
            position: absolute;
            bottom: 15px;
            right: 20px;
            background: rgba(0,0,0,0.7);
            color: white;
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 14px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .thumb-strip {
            display: flex;
            gap: 10px;
            overflow-x: auto;
            margin: 15px 20px 0 20px;
            padding-bottom: 10px;
            scroll-behavior: smooth;
        }

        .thumb-item {
            width: 80px;
            height: 80px;
            flex-shrink: 0;
            cursor: pointer;
            border-radius: 8px;
            overflow: hidden;
            border: 3px solid transparent;
            opacity: 0.5;
            transition: 0.3s;
            background: #000;
        }

            .thumb-item.active {
                border-color: #f39c12;
                opacity: 1;
            }

            .thumb-item img, .thumb-item video {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .thumb-strip::-webkit-scrollbar {
            height: 8px;
        }

        .thumb-strip::-webkit-scrollbar-thumb {
            background: #555;
            border-radius: 4px;
        }

            .thumb-strip::-webkit-scrollbar-thumb:hover {
                background: #888;
            }
    </style>

    <div class="chotot-gallery">
        @if (Model.HinhAnhPhong != null && Model.HinhAnhPhong.Any())
        {
            var hinhAnhList = Model.HinhAnhPhong.ToList();

            <!-- Màn hình chính -->
            <div class="main-view">
                <button class="nav-btn prev-btn" onclick="doiMedia(-1)"><i class="glyphicon glyphicon-chevron-left"></i></button>

                <div id="main-media-content" style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;">
                    <!-- Nội dung sẽ được Javascript bơm vào đây -->
                </div>

                <button class="nav-btn next-btn" onclick="doiMedia(1)"><i class="glyphicon glyphicon-chevron-right"></i></button>
                <div class="media-counter"><span id="current-idx">1</span> / @hinhAnhList.Count</div>
            </div>

            <!-- Thanh trượt Thumbnail -->
            <div class="thumb-strip" id="thumb-strip">
                @for (int i = 0; i < hinhAnhList.Count; i++)
                {
                    var anh = hinhAnhList[i];
                    var isVideo = anh.UrlHinhAnh.ToLower().EndsWith(".mp4");

                    <div class="thumb-item @(i == 0 ? "active" : "")" id="thumb-@i" onclick="chonMedia(@i)" data-url="@anh.UrlHinhAnh" data-type="@(isVideo ? "video" : "image")">
                        @if (isVideo)
                        {
                            <video src="@anh.UrlHinhAnh" muted></video>
                        }
                        else
                        {
                            <img src="@anh.UrlHinhAnh" />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center" style="padding: 50px; background: white; border-radius: 10px; margin: 20px;">
                <i class="glyphicon glyphicon-picture text-muted" style="font-size: 50px;"></i>
                <p class="text-muted" style="margin-top: 15px;">Phòng trọ này chưa có hình ảnh.</p>
            </div>
        }
    </div>
</div>

<!-- Thông tin chi tiết & Cột Đặt lịch -->
<div class="row">
    <!-- Cột trái: Thông số & Tiện ích -->
    <div class="col-md-8">
        <div style="background: #ffffff; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
            <h3 style="color: #1e293b; font-size: 18px; font-weight: 700; margin-top: 0; padding-bottom: 12px; border-bottom: 2px solid #2563eb;">
                Thông số & Chi phí thuê
            </h3>
            <div class="row" style="margin-top: 15px;">
                <div class="col-xs-6 col-sm-3" style="margin-bottom: 15px;">
                    <div style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #f1f5f9; text-align: center;">
                        <span style="font-size: 12px; color: #64748b; font-weight: 600;">Giá thuê</span>
                        <div style="font-size: 18px; font-weight: 800; color: #dc2626; margin-top: 4px;">@string.Format("{0:N0}", Model.GiaThue) đ</div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-3" style="margin-bottom: 15px;">
                    <div style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #f1f5f9; text-align: center;">
                        <span style="font-size: 12px; color: #64748b; font-weight: 600;">Tiền cọc</span>
                        <div style="font-size: 16px; font-weight: 700; color: #1e293b; margin-top: 4px;">@(Model.TienCoc.HasValue ? string.Format("{0:N0} đ", Model.TienCoc) : "0 đ")</div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-3" style="margin-bottom: 15px;">
                    <div style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #f1f5f9; text-align: center;">
                        <span style="font-size: 12px; color: #64748b; font-weight: 600;">Diện tích</span>
                        <div style="font-size: 16px; font-weight: 700; color: #1e293b; margin-top: 4px;">@Model.DienTich m²</div>
                    </div>
                </div>
                <div class="col-xs-6 col-sm-3" style="margin-bottom: 15px;">
                    <div style="background: #f8fafc; padding: 14px; border-radius: 12px; border: 1px solid #f1f5f9; text-align: center;">
                        <span style="font-size: 12px; color: #64748b; font-weight: 600;">Sức chứa</span>
                        <div style="font-size: 16px; font-weight: 700; color: #1e293b; margin-top: 4px;">@Model.SucChua người</div>
                    </div>
                </div>
            </div>

            <div style="margin-top: 10px; background: #eff6ff; padding: 14px 18px; border-radius: 12px; border: 1px solid #dbeafe; display: flex; flex-wrap: wrap; gap: 20px; font-size: 13px; color: #1e40af;">
                <div><i class="fa-solid fa-bolt" style="color: #f59e0b; margin-right: 6px;"></i> Điện: <strong>@(Model.TienDien.HasValue ? string.Format("{0:N0} đ/kWh", Model.TienDien) : "Giá nhà nước")</strong></div>
                <div><i class="fa-solid fa-droplet" style="color: #0284c7; margin-right: 6px;"></i> Nước: <strong>@(Model.TienNuoc.HasValue ? string.Format("{0:N0} đ/tháng", Model.TienNuoc) : "Giá nhà nước")</strong></div>
                <div><i class="fa-solid fa-wifi" style="color: #2563eb; margin-right: 6px;"></i> Wifi/Dịch vụ: <strong>@(Model.PhiDichVu.HasValue ? string.Format("{0:N0} đ", Model.PhiDichVu) : "Miễn phí")</strong></div>
            </div>
        </div>

        <!-- Tiện ích đi kèm -->
        <div style="background: #ffffff; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 24px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
            <h3 style="color: #1e293b; font-size: 18px; font-weight: 700; margin-top: 0; padding-bottom: 12px; border-bottom: 2px solid #2563eb;">
                Tiện ích sẵn có
            </h3>
            <div class="row" style="margin-top: 15px;">
                @if (Model.TienIch != null && Model.TienIch.Any())
                {
                    foreach (var ti in Model.TienIch)
                    {
                        <div class="col-xs-6 col-sm-4" style="margin-bottom: 12px;">
                            <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #334155;">
                                <i class="fa-solid fa-circle-check" style="color: #2563eb;"></i>
                                <span>@ti.TenTienIch</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-xs-12" style="color: #94a3b8;">Chưa cập nhật tiện ích.</div>
                }
            </div>
        </div>
        <!-- BẢN ĐỒ VỊ TRÍ PHÒNG TRỌ (Đặt bên trong col-md-8) -->
        <div style="background: white; border-radius: 10px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 25px;">
            <h4 style="font-weight: bold; color: #1a4b82; margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #eee; padding-bottom: 10px;">
                <i class="glyphicon glyphicon-map-marker"></i> Bản đồ vị trí
            </h4>

            @{
                string diaChi = "";
                if (!string.IsNullOrEmpty(Model.DiaChiChiTiet))
                {
                    diaChi += Model.DiaChiChiTiet + ", ";
                }
                if (Model.TuyenDuong != null)
                {
                    diaChi += Model.TuyenDuong.TenDuong + ", ";
                }
                if (Model.PhuongXa != null)
                {
                    diaChi += Model.PhuongXa.TenPhuongXa + ", ";
                }
                diaChi += "TP. Cà Mau, Cà Mau";

                string mapQuery = Uri.EscapeDataString(diaChi);
            }

            <div style="border-radius: 8px; overflow: hidden; border: 1px solid #ddd;">
                <iframe width="100%"
                        height="300"
                        frameborder="0"
                        style="border:0;"
                        src="https://maps.google.com/maps?q=@mapQuery&hl=vi&z=15&output=embed"
                        allowfullscreen>
                </iframe>
            </div>
            <p class="text-muted mt-2" style="font-size: 13px; margin-top: 10px;"><i class="glyphicon glyphicon-info-sign"></i> Vị trí trên bản đồ mang tính chất tương đối dựa trên tên đường và phường/xã.</p>
        </div>
    </div>
  
    <!-- Cột phải: Chủ trọ & Đặt lịch hẹn -->
    <div class="col-md-4">
        <!-- Thẻ Chủ trọ -->
        <div style="background: #ffffff; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; margin-bottom: 24px; text-align: center; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
            <div style="width: 60px; height: 60px; border-radius: 50%; background: #204a7a; color: #ffffff; font-size: 24px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px auto;">
                @(Model.NguoiDung != null ? Model.NguoiDung.HoTen.Substring(0, 1) : "C")
            </div>
            <h4 style="color: #1e293b; font-size: 18px; font-weight: 700; margin: 0 0 4px 0;">@(Model.NguoiDung != null ? Model.NguoiDung.HoTen : "Chủ Nhà Trọ")</h4>
            <p style="color: #64748b; font-size: 13px; margin-bottom: 16px;">Thời gian liên hệ: @(Model.ThoiGianLienHe ?? "Cả ngày")</p>

            <a href="tel:@(Model.NguoiDung != null ? Model.NguoiDung.SoDienThoai : "")" style="display: block; width: 100%; background: #f59e0b; color: #ffffff; font-weight: 700; padding: 12px; border-radius: 10px; text-decoration: none; font-size: 15px; box-shadow: 0 2px 4px rgba(245,158,11,0.3);">
                <i class="fa-solid fa-phone" style="margin-right: 6px;"></i> @(Model.NguoiDung != null ? Model.NguoiDung.SoDienThoai : "0912345678")
            </a>
        </div>

        <!-- Form Đặt Lịch Hẹn -->
        <div style="background: #ffffff; padding: 24px; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
            <h4 style="color: #1e293b; font-size: 17px; font-weight: 700; margin-top: 0; margin-bottom: 16px; display: flex; align-items: center; gap: 8px;">
                <i class="fa-regular fa-calendar-check" style="color: #2563eb;"></i> Đặt lịch hẹn xem phòng
            </h4>

            @using (Html.BeginForm("DatLichHen", "Home", FormMethod.Post, new { style = "display: flex; flex-direction: column; gap: 14px;" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="PhongID" value="@Model.PhongID" />

                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Thời gian muốn xem *</label>
                    <input type="datetime-local" name="ThoiGianHen" required style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;" />
                </div>

                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 6px;">Ghi chú gửi chủ trọ</label>
                    <textarea name="GhiChu" rows="3" placeholder="VD: Em là sinh viên muốn qua xem phòng..." style="width: 100%; padding: 10px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13px;"></textarea>
                </div>

                <button type="submit" style="width: 100%; background: #2563eb; color: #ffffff; font-weight: 700; padding: 12px; border: none; border-radius: 10px; font-size: 14px; cursor: pointer; transition: 0.2s; box-shadow: 0 2px 4px rgba(37,99,235,0.3);">
                    <i class="fa-solid fa-paper-plane" style="margin-right: 6px;"></i> Gửi yêu cầu đặt lịch
                </button>
            }
        </div>
    </div>
</div>
@section scripts {
    <script>
        var currentMediaIndex = 0;
        var totalMedia = 0;

        $(document).ready(function () {
            totalMedia = $('.thumb-item').length;
            if (totalMedia > 0) {
                chonMedia(0); // Tải ảnh đầu tiên khi vừa vào trang
            }
        });

        // Hàm click chọn ảnh
        function chonMedia(index) {
            // Xử lý quay vòng nếu bấm quá giới hạn
            if (index < 0) index = totalMedia - 1;
            if (index >= totalMedia) index = 0;

            currentMediaIndex = index;

            // Đổi hiệu ứng sáng/tối cho thumbnail
            $('.thumb-item').removeClass('active');
            $('#thumb-' + index).addClass('active');

            // Cập nhật bộ đếm
            $('#current-idx').text(index + 1);

            // Lấy URL và định dạng (Ảnh/Video)
            var thumb = $('#thumb-' + index);
            var url = thumb.data('url');
            var type = thumb.data('type');

            // Render vào khung hình chính
            var contentHtml = '';
            if (type === 'video') {
                contentHtml = '<video controls autoplay style="max-width: 100%; max-height: 100%; object-fit: contain;"><source src="' + url + '" type="video/mp4"></video>';
            } else {
                contentHtml = '<img src="' + url + '" style="max-width: 100%; max-height: 100%; object-fit: contain;" />';
            }
            $('#main-media-content').html(contentHtml);

            // Tự động cuộn thanh thumbnail theo ảnh đang xem
            var strip = document.getElementById('thumb-strip');
            var activeThumb = document.getElementById('thumb-' + index);
            if (strip && activeThumb) {
                strip.scrollLeft = activeThumb.offsetLeft - (strip.offsetWidth / 2) + (activeThumb.offsetWidth / 2) - 20;
            }
        }

        // Hàm nút bấm Trái/Phải
        function doiMedia(direction) {
            chonMedia(currentMediaIndex + direction);
        }
    </script>
}